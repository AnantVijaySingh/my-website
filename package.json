{
  "name": "my-website",
  "version": "1.0.0",
  "description": "my personal website hosted at anantvijay.com",
  "main": "index.js",
  "scripts": {
    "start": "vite",
    "build": "tsc && node index-generator.js && node generate-pages.js",
    "build:essays": "node index-generator.js && node generate-pages.js",
    "build:watch": "tsc --watch",
    "build:sitemap": "node generate-sitemap.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:guard": "node --test tests/unit/baseline.test.js tests/unit/build.test.js tests/unit/links.test.js tests/unit/dates.test.js tests/unit/order.test.js",
    "test:design": "node --test tests/unit/tokens.test.js tests/unit/markup.test.js tests/unit/coverage.test.js",
    "test:baseline": "node tests/capture-baseline.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "marked": "^15.0.4"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
